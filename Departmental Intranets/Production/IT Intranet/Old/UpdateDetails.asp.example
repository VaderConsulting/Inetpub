<%@Language = VBScript%>
<!-- #Include file="Includes/Menu.asp" -->
<%
Function Check(Current)
	If Current = CurrentCountryCode Then
		Check = "Selected"
	Else
		Check = ""
	End If
End Function

	response.expires = 0

	'CONST ServiceAccount = "Intranet\Mark"
	'CONST ServicePassword = "REDACTED"
	Dim ServiceAccount
	ServiceAccount = Application("ADServiceAccount")		'"EXAMPLE\svc-example"
	Dim ServicePassword
	ServicePassword =REDACTED"ADServicePassword")	'"example-password"

	Const ADS_SECURE_AUTHENTICATION = 1
	Const ADS_USE_ENCRYPTION = 2
	Const ADS_PROPERTY_CLEAR = 1

	'Define the local variables
	Dim lstrUserAccount
	Dim lstrDisplayUser
	Dim llngCounter
	Dim lstrErrorMessage
	Dim lblnHideFields
	Dim CurrentCountryCode
	
	'define the recordset objects
	Dim adoConn
	Dim adoCmd
	Dim adoRS
	
	'Grab the users account details
	lstrUserAccount = UCASE(Request.ServerVariables("LOGON_USER"))
	lstrDisplayUser = UCASE(Replace(lstrUserAccount, "OXIANA\", ""))
	
	'check if the user has posted some information back
	If (len(request.form("ADSPath")) > 0) Then
		
		'The user has changed their information, so update AD
		Dim lstrTelephoneNumber
		Dim lstrCompany
		Dim lstrSt
		Dim lstrHomePhone
		Dim lstrStreetAddress
		Dim lstrFacsimileTelephoneNumber
		Dim lstrDescription
		Dim lstrPostalCode
		Dim lstrPhysicalDeliveryOfficeName
		Dim lstrMobile
		Dim lstrL
		Dim lstrTitle
		Dim lstrDepartment
		Dim lstrCountryCode
		
		'grab the users new details and make sure that they have entered valid data
		lstrTelephoneNumber = Request.Form("TelephoneNumber")
		lstrCompany = Request.Form("Company")
		lstrSt = Request.Form("St")
		lstrStreetAddress = Request.Form("StreetAddress")
		lstrFacsimileTelephoneNumber = Request.Form("FacsimileTelephoneNumber")
		lstrDescription = Request.Form("Description")
		lstrPostalCode = Request.Form("PostalCode")
		lstrPhysicalDeliveryOfficeName = Request.Form("PhysicalDeliveryOfficeName")
		lstrMobile = Request.Form("Mobile")
		lstrL = Request.Form("L")
		lstrTitle = Request.Form("Title")
		lstrDepartment = Request.Form("Department")
		lstrCountryCode = Request.Form("CountryCode")

		
		'define the loval variables/objects
		Dim objLDAPProvider
		Dim objUser
		
		'create the LDAP Provider object
		Set objLDAPProvider = GetObject("LDAP:")
		
		'locate the AD user for editing
		Set objUser = objLDAPProvider.OpenDSObject(Request.Form("ADSPath"), ServiceAccount, ServicePassword, ADS_SECURE_AUTHENTICATION)
		
		'save the new information into AD
		If Len(lstrTelephoneNumber) = 0 Then
			objUser.PutEx ADS_PROPERTY_CLEAR, "telephoneNumber", vbNull
		Else
			objUser.TelephoneNumber = lstrTelephoneNumber
		End If
		If Len(lstrCompany) = 0 Then
			objUser.PutEx ADS_PROPERTY_CLEAR, "Company", vbNullString
		Else
			objUser.Company = lstrCompany
		End If
		If Len(lstrSt) = 0 Then
			objUser.PutEx ADS_PROPERTY_CLEAR, "st", vbNullString
		Else
			objUser.St = lstrSt
		End If
		If Len(lstrStreetAddress) = 0 Then
			objUser.PutEx ADS_PROPERTY_CLEAR, "StreetAddress", vbNullString
		Else
			objUser.StreetAddress = lstrStreetAddress
		End If
		If Len(lstrFacsimileTelephoneNumber) = 0 Then
			objUser.PutEx ADS_PROPERTY_CLEAR, "FacsimileTelephoneNumber", vbNullString
		Else
			objUser.FacsimileTelephoneNumber = lstrFacsimileTelephoneNumber
		End If
		If Len(Trim(lstrDescription)) = 0 Then
			objUser.PutEx ADS_PROPERTY_CLEAR, "Description", vbNullString
		Else
			objUser.Description = lstrDescription
		End If
		If Len(lstrPostalCode) = 0 Then
			objUser.PutEx ADS_PROPERTY_CLEAR, "PostalCode", vbNullString
		Else
			objUser.PostalCode = lstrPostalCode
		End If
		If Len(lstrPhysicalDeliveryOfficeName) = 0 Then
			objUser.PutEx ADS_PROPERTY_CLEAR, "PhysicalDeliveryOfficeName", vbNullString
		Else
			objUser.PhysicalDeliveryOfficeName = lstrPhysicalDeliveryOfficeName
		End If
		If Len(lstrMobile) = 0 Then
			objUser.PutEx ADS_PROPERTY_CLEAR, "Mobile", vbNullString
		Else
			objUser.Mobile = lstrMobile
		End If
		If Len(lstrL) = 0 Then
			objUser.PutEx ADS_PROPERTY_CLEAR, "L", vbNullString
		Else
			objUser.L = lstrL
		End If
		If Len(lstrTitle) = 0 Then
			objUser.PutEx ADS_PROPERTY_CLEAR, "Title", vbNullString
		Else
			objUser.Title = lstrTitle
		End If
		If Len(lstrDepartment) = 0 Then
			objUser.PutEx ADS_PROPERTY_CLEAR, "Department", vbNullString
		Else
			objUser.Department = lstrDepartment
		End If
		If Len(lstrCountryCode) = 0 Then
			objUser.PutEx ADS_PROPERTY_CLEAR, "CountryCode", vbNullString
		Else
			objUser.CountryCode = lstrCountryCode
		End If

		'apply the changes
		On Error Resume Next
		objUser.SetInfo
		If (Err.Number <> 0) Then
		  lstrErrorMessage = "<SPAN style=""COLOR:#FF0000"">An error was encountered while trying to update the AD database. Please contact an administrator.</SPAN><BR><BR>"
		  lstrErrorMessage = lstrErrorMessage + "<!-- (" + CStr(Err.Number) + ") " + Err.Description + " -->"
		  Err.Clear
		Else
   		lstrErrorMessage = "<SPAN style=""COLOR:#FF0000"">Your Active Directory details were successfully updated.</SPAN><BR><BR>"
		End If
		On Error Goto 0
		
		'release the objects
		Set objUser = Nothing
		Set objLDAPProvider = Nothing
		
	End If 

	'create the connection object
	Set adoConn = CreateObject("ADODB.Connection")
	
	'Attempt to locate the user account in AD
	adoConn.Provider = "ADsDSOObject"
	adoConn.Properties("User ID") = ServiceAccount
	adoConn.Properties("Password") = ServicePassword
	adoConn.Properties("ADSI Flag") = 1
	adoConn.Properties("Encrypt Password") = True
	adoConn.Open "ADSI"
	Set adoCmd = CreateObject("ADODB.Command")
	Set adoCmd.ActiveConnection = adoConn
	adoCmd.CommandText = "<LDAP://DC=Oxiana,DC=com,DC=au>;(&(objectCategory=user)(sAMAccountName=" + lstrDisplayUser + "));ADsPath,CN,givenName,mail,sn,telephoneNumber,company,st,streetAddress,facsimileTelephoneNumber,description,postalcode,physicalDeliveryOfficeName,mobile,l,title,Department,countryCode;subtree"
	On Error Resume Next
	Set adoRS = adoCmd.Execute
	On Error Goto 0
	If UCase(typename(adoRS)) = "EMPTY" Then
		lstrErrorMessage = "<SPAN style=""COLOR:#FF0000"">An error was encountered while trying to connect to the AD database. Please contact an administrator.</SPAN>"
		lblnHideFields = True
	ElseIf adoRS.EOF Then
		lstrErrorMessage = "<SPAN style=""COLOR:#FF0000"">The specified user account could not be found.</SPAN>" + "<!-- " + adoCmd.CommandText + " -->"
		lblnHideFields = True
	else
		CurrentCountryCode = adoRS.Fields("CountryCode")
	End If
%>
<HTML>
<HEAD>
	<TITLE>IT Intranet: Update My Details</TITLE>
	<link rel="stylesheet" href="Styles/Style.css" type="text/css"></link>
	<SCRIPT language=JavaScript>
	<!--
	function HideNonPrintables()
	{
		for (Counter=0;Counter<HidePrint.length;Counter++) HidePrint[Counter].style.display = 'None';
	}
	function ShowNonPrintables()
	{
		for (Counter=0;Counter<HidePrint.length;Counter++) HidePrint[Counter].style.display = 'Inline';
	}
	//-->
	</SCRIPT>
</HEAD>

<BODY onbeforeprint="HideNonPrintables()" onafterprint="ShowNonPrintables()">
	<TABLE width=770 cellpadding=0 cellspacing=0 align=center width=770>
		<TR id=HidePrint height=79><TD colspan=3 background=Images/Logo.gif align=right class=Copyright><A href="SiteMap.asp">Site Map</A><IMG align="absmiddle" width=19 height=12 src="Images/PrivacyDivider.gif"><A href="ContactUs.asp">Contact Us</A></TD></TR>
		<TR id=HidePrint><TD colspan=3><IMG height=11 width=770 src="Images/DottedLine.gif"></TD></TR>
		<TR id=HidePrint>
			<TD width=190><DIV class=HomeLink><A href="index.asp" width=100%>HOME</A></DIV></TD>
			<TD width=10>&nbsp;</TD>
			<TD width=570>&nbsp;</TD>
		</TR>
		<TR id=HidePrint><TD colspan=3><IMG height=11 width=770 src="Images/DottedLine.gif"></TD></TR>
		<TR>
			<TD id=HidePrint width=190 valign=top>
				<TABLE cellpadding=0 cellspacing=0 width=100%>
					<%ShowMenu%>
				</TABLE>
			</TD>
			<TD width=10></TD>
			<TD width=570 valign=top>
				<SPAN class=MainHeading style="display:inline;width:460px; height:21px">Update My Details</SPAN><SPAN class=Copyright style="padding-top:6px;padding-right:25px;display:inline;width:110px;HEIGHT:21px;cursor:hand;BACKGROUND-IMAGE:url('Images/PrintArrow.gif')" onclick="window.print()">Print this page</SPAN><BR><BR>
				
				<%= lstrErrorMessage%>
				
				<%If lblnHideFields <>  True Then%>
				Please check the following fields to ensure that your details are correctly entered. The information contained here will be used in the OXIANA Global Address Book.
				<FORM action="UpdateDetails.asp" method=post>
					<TABLE cellpadding=0 cellspacing=0>
						<TR>
							<TD class=SubHeading style="TEXT-ALIGN:Right">Account Name:&nbsp;</TD>
							<TD><%= lstrDisplayUser%></TD>
						</TR>
						<TR>
							<TD class=SubHeading style="TEXT-ALIGN:Right">Given Name:&nbsp;</TD>
							<TD><%= Trim(adoRS.Fields("GivenName"))%></TD>
						</TR>
						<TR>
							<TD class=SubHeading style="TEXT-ALIGN:Right">Last Name:&nbsp;</TD>
							<TD><%= Trim(adoRS.Fields("SN"))%></TD>
						</TR>
						<TR><TD>&nbsp;</TD></TR>
						<TR>
							<TD class=SubHeading style="TEXT-ALIGN:Right">Title:&nbsp;</TD>
							<TD><INPUT  name="Title" value="<%= Trim(adoRS.Fields("Title"))%>"></TD>
						</TR>
						<TR>
							<TD class=SubHeading style="TEXT-ALIGN:Right">Department:&nbsp;</TD>
							<TD><INPUT  name="Department" value="<%= Trim(adoRS.Fields("Department"))%>"></TD>
						</TR>
						<TR>
							<TD class=SubHeading style="TEXT-ALIGN:Right">Company:&nbsp;</TD>
							<TD>
								<SELECT name=Company>
									<OPTION value="">-- Not Specified --</OPTION>
									<OPTION value="Oxiana" <%If Trim(adoRS.Fields("Company")) = "Oxiana" Then Response.write "Selected" End If%>>Oxiana</OPTION>
									<OPTION value="Empired" <%If Trim(adoRS.Fields("Company")) = "Empired" Then Response.write "Selected" End If%>>Empired</OPTION>
									<OPTION value="Mincom" <%If Trim(adoRS.Fields("Company")) = "Mincom" Then Response.write "Selected" End If%>>Mincom</OPTION>
								</SELECT>
							</TD>
						</TR>
						<TR><TD>&nbsp;</TD></TR>
						<TR>
							<TD class=SubHeading style="TEXT-ALIGN:Right">Email:&nbsp;</TD>
							<TD><%= Trim(adoRS.Fields("Mail"))%></TD>
						</TR>
						<TR>
							<TD class=SubHeading style="TEXT-ALIGN:Right">Phone:&nbsp;</TD>
							<TD><INPUT size=10 maxlength=15 name="TelephoneNumber" value="<%= Trim(adoRS.Fields("TelephoneNumber"))%>"></TD>
						</TR>
						<TR>
							<TD class=SubHeading style="TEXT-ALIGN:Right">Fax:&nbsp;</TD>
							<TD><INPUT size=10 maxlength=15 name="FacsimileTelephoneNumber" value="<%= Trim(adoRS.Fields("FacsimileTelephoneNumber"))%>"></TD>
						</TR>
						<TR>
							<TD class=SubHeading style="TEXT-ALIGN:Right">Mobile:&nbsp;</TD>
							<TD><INPUT size=12 maxlength=18 name="Mobile" value="<%= Trim(adoRS.Fields("Mobile"))%>"></TD>
						</TR>
						<TR><TD>&nbsp;</TD></TR>
						<TR>
							<TD class=SubHeading style="TEXT-ALIGN:Right">Street:&nbsp;</TD>
							<TD>
								<INPUT name="StreetAddress" value="<%= Trim(adoRS.Fields("StreetAddress"))%>">
							</TD>
						</TR>
						<TR>
							<TD class=SubHeading style="TEXT-ALIGN:Right">City:&nbsp;</TD>
							<TD><INPUT size=20 maxlength=20 name="L" value="<%= Trim(adoRS.Fields("L"))%>"></TD>
						</TR>
						<TR>
							<TD class=SubHeading style="TEXT-ALIGN:Right">State:&nbsp;</TD>
							<TD><INPUT size=6 maxlength=4 name="St" value="<%= Trim(adoRS.Fields("St"))%>"></TD>
						</TR>
						<TR>
							<TD class=SubHeading style="TEXT-ALIGN:Right">Post Code:&nbsp;</TD>
							<TD><INPUT size=6 maxlength=8 name="PostalCode" value="<%= Trim(adoRS.Fields("PostalCode"))%>"></TD>
						</TR>
						<TR>
							<TD class=SubHeading style="TEXT-ALIGN:Right">Country:&nbsp;</TD>
							<TD>
								<SELECT name=CountryCode>
									<OPTION value="">-- Not Specified --</OPTION>
