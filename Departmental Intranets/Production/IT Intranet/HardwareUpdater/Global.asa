Sub LoadXML

	'define the XML object
	Dim XML
	Dim lobjNodes
	Dim lvarTemp
	Set XML = Server.CreateObject("MSXML2.DOMDocument")
	
	'load the XML
	if XML.load(Application("XMLFilePath") & "Hardware.xml") = true then
		
		'store the XML object for later use
		Set Session("XML") = XML
	else
		
		'clear the session
		Session.Abandon
		
		'inform the user that there was an error loading the XML file
		Response.Write "Unable to read the XML Catalogue file..."
		Response.End
	end if
End Sub
