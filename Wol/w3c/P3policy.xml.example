- <POLICY xmlns="http://www.w3.org/2000/P3Pv1" discuri="WoLsLAN WEB SITE'S PRIVACY POLICY">
- <!--  Description of the entity making this policy statement. 
  --> 
- <ENTITY>
- <DATA-GROUP>
  <DATA ref="#business.name">WoLsLAN</DATA> 
  <DATA ref="#business.contact-info.online.email">redacted@example.com</DATA> 
  <DATA ref="#business.contact-info.online.uri">www.WOLSLNA.net</DATA> 
  <DATA ref="#business.contact-info.telecom.telephone">XXX</DATA> 
  <DATA ref="#business.contact-info.postal.formatted">XXX</DATA> 
  </DATA-GROUP>
  </ENTITY>
- <!--  Disclosure 
  --> 
- <ACCESS>
  <nonident /> 
  </ACCESS>
- <!--  Disputes 
  --> 
- <DISPUTES-GROUP>
- <DISPUTES resolution-type="service" service="www.WOLSLAN.net" short-description="Service">
- <REMEDIES>
  <correct /> 
  </REMEDIES>
  </DISPUTES>
  </DISPUTES-GROUP>
- <!--  Statement for group "Everyone" 
  --> 
- <STATEMENT>
- <EXTENSION optional="true">
  <GROUP-INFO xmlns="http://www.software.ibm.com/P3P/editor/extension-1.0.html" name="Everyone" /> 
  </EXTENSION>
- <!--  Use (purpose) 
  --> 
- <PURPOSE>
  <admin /> 
  <current /> 
  <develop /> 
  </PURPOSE>
- <!--  Recipients 
  --> 
- <RECIPIENT>
  <ours /> 
  </RECIPIENT>
- <!--  Retention 
  --> 
- <RETENTION>
  <indefinitely /> 
  </RETENTION>
- <!--  Base dataschema elements. 
  --> 
- <DATA-GROUP>
  <DATA ref="#dynamic.clickstream.client" /> 
  <DATA ref="#dynamic.clickstream.server" /> 
  <DATA ref="#dynamic.http.useragent" /> 
  <DATA ref="#dynamic.http.referrer" /> 
  </DATA-GROUP>
  </STATEMENT>
- <!--  End of policy 
  --> 
  </POLICY>