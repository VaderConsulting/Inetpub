<!--#include file="Database.asp"-->
<!DOCTYPE HTML PUBLIC "-//W3C//DTD HTML 4.0 Transitional//EN">
<HTML>
<HEAD>
<TITLE>Mail to Everyone</TITLE>
<!-- InstanceEndEditable --> 
<meta http-equiv="Content-Type" content="text/html; charset=iso-8859-1">
<style type="text/css">
<!--
.standard {
	font-family: Geneva, Arial, Helvetica, san-serif;
	font-size: 12px;
	font-style: normal;
	line-height: normal;
	font-weight: normal;
	font-variant: normal;
	text-transform: none;
	color: #333333;
	text-decoration: none;
}
.content {
	font-family: Geneva, Arial, Helvetica, san-serif;
	font-size: 12px;
	font-style: normal;
	line-height: normal;
	font-weight: normal;
	font-variant: normal;
	text-transform: none;
	color: #000000;
	text-decoration: none;
}
a {
	font-family: Geneva, Arial, Helvetica, san-serif;
	font-size: 12px;
	font-style: normal;
	line-height: normal;
	font-weight: normal;
	font-variant: normal;
	text-transform: none;
	color: #333333;
	text-decoration: none;
}
-->
</style>
</HEAD>
<BODY bgcolor="#666666">
<%
  Dim strEmail, strPassword
  strEMail = Request("EMail")
  strPassword =REDACTED"Password")
  Set rsItem = Server.CreateObject("ADODB.Recordset")
  strSQL = "SELECT * FROM Users "
' WHERE EMailAddress = '" & strEMail & "';"
  rsItem.Open strSQL, objConn
'  strEmail = rsItem("EMailAddress")
  strPassword =REDACTED"Password")
  strFirstName = rsItem("FirstName")
  
 

  %>



<%

Do While Not rsItem.EOF



Dim objCDO, QUOT
Set objCDO = Server.CreateObject("CDONTS.NewMail")

QUOT = Chr(34)

' This code assumes the above CDO 
'instantiation code is included
objCDO.To = QUOT & rsItem("FirstName") + Chr(32) + rsItem("LastName") & QUOT & rsItem("EMailAddress")
Response.Write "<BR>" & rsItem("FirstName") + Chr(32) + rsItem("LastName") + Chr(32) + rsItem("EMailAddress")
objCDO.From = QUOT & "WoL" & QUOT & "redacted@example.com"


Dim txtBody, txtBegin
txtBegin = "Dear " & rsItem("FirstName") & ","
cr = chr(13)

'chr(32) = space
'chr(8) = backspace
'chr(10) = linefeed
'chr(13) = carriage return





objCDO.Subject = Request.Form("Subject")
objCDO.Body = txtBegin + cr + cr + Request.Form("body")
objCDO.Send
rsItem.MoveNext
    Loop
    rsItem.close
    Set rsItem = Nothing
%>




</BODY>
</HTML>