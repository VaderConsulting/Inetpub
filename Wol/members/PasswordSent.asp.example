<!--#include file="Database.asp"-->

<%
  Dim strEmail, strPassword

  Set rsItem = Server.CreateObject("ADODB.Recordset")
  strSQL = "SELECT * FROM Users WHERE Username = '" & Request.Form("Username") & "';"
  rsItem.Open strSQL, objConn

  If Not rsItem.EOF Then
  
  
  strPassword =REDACTED"Password")
  strFirstName = rsItem("FirstName")
  







Dim objCDO, QUOT
Set objCDO = Server.CreateObject("CDONTS.NewMail")

QUOT = Chr(34)

' This code assumes the above CDO 
'instantiation code is included
objCDO.To = QUOT & rsItem("FirstName") + Chr(32) + rsItem("LastName") & QUOT & rsItem("EMailAddress")

objCDO.From = QUOT & "Alan Woodman" & QUOT & "redacted@example.com"
'objCDO.cc = "redacted@example.com"

Dim txtBody, txtBegin, txtAddress, txtHere

txtBegin = "Dear " & rsItem("FirstName") & ","
txtBody = "Your password is: " & rsItem("Password")
txtHere = "Click on the link below to sign into the Members Area of Wol's Page"
txtAddress = "http://www.wolslan.net"

cr = chr(13)
'chr(32) = space
'chr(8) = backspace
'chr(10) = linefeed
'chr(13) = carriage return


objCDO.Subject = "Your Password"
objCDO.Body = txtBegin + cr + cr + txtBody + cr + cr + txtHere + cr + cr + txtAddress
objCDO.Send

%>


<div align="center"><font size="+3">Your password has been sent to the following E-mail Address:<BR>
<%= rsItem("EMailAddress") %>

</font></div>
<% 
rsItem.Close
Set rsItem = Nothing 

Else
	Response.Write "<font size=+4><font color=#FF0000>Username not found!!!</font></font><P>&nbsp;</P>"
	Response.Write "<P>Please send <a href=mailto:redacted@example.com>me</a> an e-mail and i will send you your username and password.<P>Regards,<BR><a href=mailto:redacted@example.com>Alan Woodman</a>."
End If
%>
