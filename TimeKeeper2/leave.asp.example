'adoConn.Open DSN
'adoRS.Open SQL, adoConn
'Response.Write "UserID: "REDACTED"UserID") & "<br>" & vbcrlf
'adoRS.Close
%>
<script language='VBScript'>
    Sub Add (Source)
        pp = instr(CStr(Source),"day") + 3
        pp2 = mid(CStr(Source),pp,4)
        DayOfWeek = Left(CStr(Source),pp-1)
        document.all.Item(Source).InnerHTML = "<font face='Tahoma' size='1' color='Red' style='cursor: hand;' onclick=""VBScript:Edit('" & DayOfWeek &  "" & pp2 & "')"">Busy</font>"
    End Sub
    
    Sub Edit (Source)
        pp = instr(CStr(Source),"day") + 3
        pp2 = mid(CStr(Source),pp,4)
        DayOfWeek = Left(CStr(Source),pp-1)
        document.all.Item(Source).InnerHTML = "<font face='Tahoma' size='1' color='Red' style='cursor: hand;' onclick=""VBScript:Add('" & DayOfWeek &  "" & pp2 & "')"">...</font>"
    End Sub
</script>
<p>
<table border='1' cellspacing='0' cellpadding='0' align='left'>
    <tr>
        <td align='center' width='50'>&nbsp;</td>
        <td align='center' width='100'>Monday</td>
        <td align='center' width='100'>Tuesday</td>
        <td align='center' width='100'>Wednesday</td>
        <td align='center' width='100'>Thursday</td>
        <td align='center' width='100'>Friday</td>
    </tr>
<%
For i = 8 to 18
    If Len(i) = 1 Then
        ii = "0" & i
    Else
        ii = Cstr(i)
    End If
%>
    <tr>
        <td>&nbsp;<%=ii%>:00</td>
        <td align='right'><span id="Monday<%=i%>"><font face="Tahoma" size="1" color="Red" style="cursor: hand;" onClick="VBScript:Add('Monday<%=i%>')">...</font></span></td>
        <td align='right'><span id="Tuesday<%=i%>"><font face='Tahoma' size='1' color='Red' style='cursor: hand;' onclick="VBScript:Add('Tuesday<%=i%>')">...</font></span></td>
        <td align='right'><span id="Wednesday<%=i%>"><font face='Tahoma' size='1' color='Red' style='cursor: hand;' onclick="VBScript:Add('Wednesday<%=i%>')">...</font></span></td>
        <td align='right'><span id="Thursday<%=i%>"><font face='Tahoma' size='1' color='Red' style='cursor: hand;' onclick="VBScript:Add('Thursday<%=i%>')">...</font></span></td>
        <td align='right'><span id="Friday<%=i%>"><font face='Tahoma' size='1' color='Red' style='cursor: hand;' onclick="VBScript:Add('Friday<%=i%>')">...</font></span></td>
    </tr>
    <tr>
        <td>&nbsp;<%=ii%>:30</td>
        <td align='right'><span id="Monday<%=i%>30"><font face='Tahoma' size='1' color='Red' style='cursor: hand;' onclick="VBScript:Add('Monday<%=i%>30')">...</font></span></td>
        <td align='right'><span id="Tuesday<%=i%>30"><font face='Tahoma' size='1' color='Red' style='cursor: hand;' onclick="VBScript:Add('Tuesday<%=i%>30')">...</font></span></td>
        <td align='right'><span id="Wednesday<%=i%>30"><font face='Tahoma' size='1' color='Red' style='cursor: hand;' onclick="VBScript:Add('Wednesday<%=i%>30')">...</font></span></td>
        <td align='right'><span id="Thursday<%=i%>30"><font face='Tahoma' size='1' color='Red' style='cursor: hand;' onclick="VBScript:Add('Thursday<%=i%>30')">...</font></span></td>
        <td align='right'><span id="Friday<%=i%>30"><font face='Tahoma' size='1' color='Red' style='cursor: hand;' onclick="VBScript:Add('Friday<%=i%>30')">...</font></span></td>
    </tr>
<%
Next
%>
</table>
</p>
